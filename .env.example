# Co notes configuration.
# Copy to .env and fill in. Never commit .env.
# On Hostinger, .env lives next to the app/ directory, OUTSIDE public_html.

# --- Public base URL of the deployed app (no trailing slash) ----------------
# Must match the domain you registered the OAuth redirect URIs against.
APP_BASE_URL=https://conotes.example.com

# Set to "dev" to see real error messages in API responses. Anything else
# behaves as production: generic messages, no stack traces.
APP_ENV=production

# --- Database (Hostinger: hPanel > Databases > MySQL Databases) -------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_conotes
DB_USER=u123456789_conotes
DB_PASS=

# --- Session ---------------------------------------------------------------
# Days a login stays valid.
SESSION_TTL_DAYS=30
# Cookie name. Change only if it collides with something else on the domain.
SESSION_COOKIE=conotes_sid

# --- Google OAuth ----------------------------------------------------------
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# Authorised redirect URI: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth ----------------------------------------------------------
# github.com/settings/developers > New OAuth App
# Authorization callback URL: {APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Retention -------------------------------------------------------------
# Days a soft-deleted card stays restorable before the cleanup job purges it.
TRASH_RETENTION_DAYS=30
# Days of board_events kept for the sync cursor. Older rows are pruned.
EVENT_RETENTION_DAYS=7

# --- Web Push (optional) ----------------------------------------------------
# Notifications when someone flags a card. Generate the pair with:
#     php tools/make-vapid.php
# Leave blank to turn the feature off - the client then hides the setting
# entirely rather than offering something that cannot work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
