# Co notes - PRODUCTION (Hostinger).
#
# Fill in the five <ANGLE BRACKET> values, rename this file to exactly `.env`,
# and upload it OUTSIDE public_html (next to app/, tools/, migrations/).
#
# Do not upload the local .env - it points at localhost and runs in dev mode,
# which would leak real error messages to visitors.

# --- Public base URL --------------------------------------------------------
# EXACTLY what visitors type, including https:// and www if you use it.
# No trailing slash. This is checked against the Origin header on every write,
# so a mismatch here breaks all editing with a confusing error.
APP_BASE_URL=https://<YOUR-DOMAIN>

# Generic error messages, no stack traces. Only flip to `dev` temporarily if
# you are debugging, and flip it back before anyone else uses the site.
APP_ENV=production

# --- Database ---------------------------------------------------------------
# hPanel > Databases > MySQL Databases. Hostinger prefixes the database name
# AND the username with your account id, e.g. u123456789_conotes.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=<HOSTINGER-DB-NAME>
DB_USER=<HOSTINGER-DB-USER>
DB_PASS=<HOSTINGER-DB-PASSWORD>

# --- Session ----------------------------------------------------------------
SESSION_TTL_DAYS=30
SESSION_COOKIE=conotes_sid

# --- Google OAuth -----------------------------------------------------------
# Same client as local dev - just add a SECOND redirect URI to it in the Google
# console, do not create a new client:
#   https://<YOUR-DOMAIN>/api/auth/google/callback
# Keep the localhost one too, so local development still works.
GOOGLE_CLIENT_ID=<SAME-AS-LOCAL>
GOOGLE_CLIENT_SECRET=<SAME-AS-LOCAL>

# --- GitHub OAuth (optional, leave blank if unused) -------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Retention --------------------------------------------------------------
TRASH_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=7

# --- Web Push (optional) ----------------------------------------------------
# Notifications when someone flags a card. Generate the pair with:
#     php tools/make-vapid.php
# Leave blank to turn the feature off - the client then hides the setting
# entirely rather than offering something that cannot work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
